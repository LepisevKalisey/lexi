#!/usr/bin/env bash
# Starts Rails and Sidekiq in the background each time the LEXI stand codespace starts.
# Assets are prebuilt by codespace-setup; after a frontend change run `bin/vite build` again.
# Logs: `overmind echo` inside the codespace; stop with `overmind quit`.
set -euo pipefail
cd /workspace

if [ -d enterprise ]; then
  echo "enterprise/ is in the working tree; run bash lexi/bin/codespace-setup first" >&2
  exit 1
fi

# A codespace stopped for idleness leaves these behind, and Rails then refuses to boot
# ("A server is already running").
rm -f tmp/pids/server.pid .overmind.sock

overmind start -D -f lexi/Procfile.stand
